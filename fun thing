local function getActiveBambooSeat()
	local char = player.Character
	local hum = char and char:FindFirstChildOfClass("Humanoid")
	local seat = hum and hum.SeatPart
	if seat and (seat.Name == "SwingSeat" or seat.Name == "SwingSeat1") then
		return seat
	end
	return nil
end

local function resetSeatThrust(seat)
	if seat and seat:IsDescendantOf(Workspace) then
		local thrust = seat:FindFirstChild("BodyThrust")
		if thrust then
			thrust.Force = Vector3.new(0, 0, 0)
		end
	end
end

local function setupCharacter(char)
	character = char
	humanoid = char:WaitForChild("Humanoid")
	rootPart = char:WaitForChild("HumanoidRootPart")

	humanoid.WalkSpeed = states.speed and config.walkSpeed or 16
	humanoid.JumpPower = states.jump and config.jumpPower or 50
	humanoid.UseJumpPower = true

	if states.giant then
		pcall(function() character:ScaleTo(config.charSize) end)
	end

	if states.spin then
		humanoid.AutoRotate = false
	end
end

if player.Character then
	setupCharacter(player.Character)
end
