local refreshTimer = 10
local refreshQueued = false

local function refreshList()
	refreshTimer = 10
	for _, child in ipairs(listFrame:GetChildren()) do
		if not child:IsA("UIListLayout") then
			child:Destroy()
		end
	end

	local filter = searchBox.Text:lower():gsub("^%s+", ""):gsub("%s+$", "")
	local candidates = {}
	for _, plr in ipairs(Players:GetPlayers()) do
		if plr ~= player then
			local dName = plr.DisplayName:lower()
			local uName = plr.Name:lower()
			if filter == "" or dName:find(filter, 1, true) or uName:find(filter, 1, true) then
				table.insert(candidates, plr)
			end
		end
	end
	table.sort(candidates, function(a, b)
		return a.Name:lower() < b.Name:lower()
	end)

	statusLabel.Text = "Players: " .. #candidates .. " | Auto-refresh: " .. (autoRefreshEnabled and "10s" or "OFF")

	for _, plr in ipairs(candidates) do
		local isViewingThis = (spectatingTarget == plr)
		local row = Instance.new("Frame")
		row.Size = UDim2.new(1, -4, 0, 42)
		row.BackgroundColor3 = isViewingThis and Color3.fromRGB(40, 32, 62) or Color3.fromRGB(28, 32, 44)
		row.BorderSizePixel = 0
		row.Parent = listFrame

		local rc = Instance.new("UICorner")
		rc.CornerRadius = UDim.new(0, 7)
		rc.Parent = row

		local nameLbl = Instance.new("TextLabel")
		nameLbl.Size = UDim2.new(0.42, -6, 1, 0)
		nameLbl.Position = UDim2.new(0, 8, 0, 0)
		nameLbl.BackgroundTransparency = 1
		nameLbl.Text = plr.DisplayName .. "\n@" .. plr.Name
		nameLbl.TextColor3 = Color3.fromRGB(240, 242, 255)
		nameLbl.Font = Enum.Font.GothamSemibold
		nameLbl.TextSize = 11
		nameLbl.TextXAlignment = Enum.TextXAlignment.Left
		nameLbl.Parent = row

		local function makeBtn(text, xPos, wScale, bgColor, onClick)
			local b = Instance.new("TextButton")
			b.Size = UDim2.new(wScale, -3, 0.72, 0)
			b.Position = UDim2.new(xPos, 0, 0.14, 0)
			b.BackgroundColor3 = bgColor
			b.Text = text
			b.TextColor3 = Color3.fromRGB(255, 255, 255)
			b.Font = Enum.Font.GothamBold
			b.TextSize = 10
			b.Parent = row

			local bc = Instance.new("UICorner")
			bc.CornerRadius = UDim.new(0, 5)
			bc.Parent = b

			b.MouseButton1Click:Connect(onClick)
			return b
		end

		makeBtn("TP", 0.43, 0.17, Color3.fromRGB(55, 115, 205), function()
			teleportToPlayer(plr)
		end)
		makeBtn(isViewingThis and "Stop" or "View", 0.60, 0.18, isViewingThis and Color3.fromRGB(165, 65, 185) or Color3.fromRGB(100, 75, 185), function()
			toggleViewPlayer(plr)
			refreshList()
		end)
		makeBtn("Fling", 0.78, 0.20, Color3.fromRGB(215, 95, 45), function()
			flingPlayer(plr)
		end)
	end

	listFrame.CanvasSize = UDim2.new(0, 0, 0, listLayout.AbsoluteContentSize.Y + 10)
end

local function scheduleRefresh()
	if refreshQueued then return end
	refreshQueued = true
	task.defer(function()
		refreshQueued = false
		refreshList()
	end)
end

unviewBtn.MouseButton1Click:Connect(function()
	stopViewing()
	refreshList()
end)

refreshBtn.MouseButton1Click:Connect(refreshList)

autoBtn.MouseButton1Click:Connect(function()
	autoRefreshEnabled = not autoRefreshEnabled
	autoBtn.Text = autoRefreshEnabled and "Auto 10s: ON" or "Auto 10s: OFF"
	autoBtn.BackgroundColor3 = autoRefreshEnabled and Color3.fromRGB(45, 165, 95) or Color3.fromRGB(70, 75, 92)
	refreshTimer = 10
	statusLabel.Text = "Players: " .. math.max(0, #Players:GetPlayers() - 1) .. " | Auto-refresh: " .. (autoRefreshEnabled and "10s" or "OFF")
end)

trackConn(searchBox:GetPropertyChangedSignal("Text"):Connect(scheduleRefresh))
trackConn(Players.PlayerAdded:Connect(scheduleRefresh))
trackConn(Players.PlayerRemoving:Connect(function(leftPlr)
	if spectatingTarget == leftPlr then
		stopViewing()
	end
	scheduleRefresh()
end))

-- ==========================================
-- MAIN UPDATE LOOP
-- ==========================================
trackConn(RunService.Heartbeat:Connect(function(dt)
	-- Spectate cleanup
	if spectatingTarget and not spectatingTarget.Parent then
		stopViewing()
	end

	-- Auto refresh countdown
	if autoRefreshEnabled then
		refreshTimer -= dt
		local shownCount = math.max(0, #Players:GetPlayers() - 1)
		local secsLeft = math.max(1, math.ceil(refreshTimer))
		statusLabel.Text = "Players: " .. shownCount .. " | Next refresh: " .. secsLeft .. "s"
		if refreshTimer <= 0 then
			refreshList()
		end
	end
end))

local renderConn = RunService.RenderStepped:Connect(function(dt)
	-- Bamboo Swing
	local seat = getActiveBambooSeat()
	if seat ~= activeSwingSeat then
		resetSeatThrust(activeSwingSeat)
		activeSwingSeat = seat
		swingCyclePhase = 0
	end

	if states.bambooSwing and activeSwingSeat then
		local thrust = activeSwingSeat:FindFirstChild("BodyThrust")
		local gyro = activeSwingSeat:FindFirstChild("BodyGyro")

		if thrust then
			local angle = config.swingAngle
			if angle >= 300 then
				if gyro then
					gyro.MaxTorque = Vector3.new(0, 400000, 400000)
				end
				local speed = activeSwingSeat.AssemblyLinearVelocity:Dot(activeSwingSeat.CFrame.LookVector)
				thrust.Force = Vector3.new(0, 0, speed >= 0 and -config.swingForce or config.swingForce)
			else
				local scale = math.clamp(angle / 180, 0.35, 1.35)
				swingCyclePhase = swingCyclePhase + dt * (2.6 / math.sqrt(scale))
				local wave = math.sin(swingCyclePhase)
				thrust.Force = Vector3.new(0, 0, -wave * config.swingForce * scale)
			end
		end
	elseif activeSwingSeat then
		resetSeatThrust(activeSwingSeat)
	end

	if not character or not humanoid or humanoid.Health <= 0 or not rootPart then return end

	-- Flight
	if states.fly and flyBodyVelocity and flyBodyGyro then
		local moveDir = Vector3.new(0, 0, 0)
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then moveDir = moveDir + camera.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then moveDir = moveDir - camera.CFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then moveDir = moveDir - camera.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then moveDir = moveDir + camera.CFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.Space) then moveDir = moveDir + Vector3.new(0, 1, 0) end
		if UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) then moveDir = moveDir - Vector3.new(0, 1, 0) end

		flyBodyVelocity.Velocity = (moveDir.Magnitude > 0 and moveDir.Unit or Vector3.new(0, 0, 0)) * config.flySpeed
		if not states.spin then
			flyBodyGyro.CFrame = camera.CFrame
		end
	end

	-- Spin
	if states.spin then
		rootPart.CFrame = rootPart.CFrame * CFrame.Angles(0, math.rad(config.spinSpeed * dt), 0)
		if states.fly and flyBodyGyro then
			flyBodyGyro.CFrame = rootPart.CFrame
		end
	end
end)

