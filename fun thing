local function getTargetPart(targetPlr)
	local char = targetPlr and targetPlr.Character
	if not char then return nil end
	return char:FindFirstChild("HumanoidRootPart")
		or char:FindFirstChild("Torso")
		or char:FindFirstChild("UpperTorso")
		or char:FindFirstChildWhichIsA("BasePart")
end

local function getMyParts()
	local char = player.Character
	if not char then return nil, nil, nil end
	local root = char:FindFirstChild("HumanoidRootPart") or char:FindFirstChildWhichIsA("BasePart")
	local hum = char:FindFirstChildOfClass("Humanoid")
	return char, root, hum
end

local function clearSeatWelds(char)
	for _, d in ipairs(char:GetDescendants()) do
		if d:IsA("Weld") or d:IsA("WeldConstraint") then
			if not d.Parent:IsA("Motor6D") then
				d:Destroy()
			end
		end
	end
end

local function stopViewing()
	spectatingTarget = nil
	if unviewBtn then unviewBtn.Visible = false end
	local _, _, myHum = getMyParts()
	camera.CameraType = Enum.CameraType.Custom
	if myHum and myHum.Parent then
		camera.CameraSubject = myHum
	end
end

local function toggleViewPlayer(targetPlr)
	if spectatingTarget == targetPlr then
		stopViewing()
		return
	end
	local tHum = targetPlr.Character and targetPlr.Character:FindFirstChildOfClass("Humanoid")
	local tPart = getTargetPart(targetPlr)
	if tHum or tPart then
		spectatingTarget = targetPlr
		if unviewBtn then unviewBtn.Visible = true end
		camera.CameraType = Enum.CameraType.Custom
		camera.CameraSubject = tHum or tPart
	end
end

local function teleportToPlayer(targetPlr)
	local myChar, myRoot, myHum = getMyParts()
	local targetPart = getTargetPart(targetPlr)
	if not myChar or not myRoot or not targetPart then return end

	if myHum and myHum.Sit then
		myHum.Sit = false
	end
	clearSeatWelds(myChar)

	local baseCF = targetPart.CFrame * CFrame.new(0, 0, 3.5)
	local rayParams = RaycastParams.new()
	rayParams.FilterType = Enum.RaycastFilterType.Exclude
	rayParams.FilterDescendantsInstances = { myChar }
	local rayOrigin = baseCF.Position + Vector3.new(0, 8, 0)
	local hit = Workspace:Raycast(rayOrigin, Vector3.new(0, -20, 0), rayParams)
	local landPos = hit and (hit.Position + Vector3.new(0, 3, 0)) or rayOrigin
	local destination = CFrame.new(landPos, landPos + baseCF.LookVector)

	if myHum then
		myHum:ChangeState(Enum.HumanoidStateType.Physics)
	end

	local elapsed = 0
	local conn
	conn = RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		if not myRoot or not myRoot.Parent or elapsed >= 0.4 then
			if conn then conn:Disconnect() end
			if myHum and myHum.Parent then
				myHum:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
			return
		end
		myRoot.AssemblyLinearVelocity = Vector3.zero
		myRoot.AssemblyAngularVelocity = Vector3.zero
		myRoot.CFrame = destination
	end)
end

local function flingPlayer(targetPlr)
	if isFlinging then return end
	local myChar, myRoot, myHum = getMyParts()
	local targetPart = getTargetPart(targetPlr)
	if not myChar or not myRoot or not targetPart then return end

	isFlinging = true
	local savedCFrame = myRoot.CFrame
	local savedLinVel = myRoot.AssemblyLinearVelocity
	local savedAngVel = myRoot.AssemblyAngularVelocity

	if myHum then
		myHum:ChangeState(Enum.HumanoidStateType.Physics)
	end

	local origCollide = {}
	for _, d in ipairs(myChar:GetDescendants()) do
		if d:IsA("BasePart") then
			origCollide[d] = d.CanCollide
			d.CanCollide = true
		end
	end

	local elapsed, conn = 0, nil
	conn = RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		local tPart = getTargetPart(targetPlr)
		if elapsed >= 0.7 or not tPart or not tPart.Parent
			or not myRoot or not myRoot.Parent then
			if conn then conn:Disconnect() end
			for part, c in pairs(origCollide) do
				if part and part.Parent then part.CanCollide = c end
			end
			if myRoot and myRoot.Parent then
				myRoot.AssemblyLinearVelocity = savedLinVel
				myRoot.AssemblyAngularVelocity = savedAngVel
				pcall(function() myChar:PivotTo(savedCFrame) end)
			end
			if myHum and myHum.Parent then
				myHum:ChangeState(Enum.HumanoidStateType.GettingUp)
			end
			isFlinging = false
			return
		end

		local pos = tPart.Position + tPart.CFrame.LookVector * -2
		myRoot.CFrame = CFrame.new(pos, tPart.Position)
		myRoot.AssemblyLinearVelocity = (tPart.Position - myRoot.Position).Unit * 400
		myRoot.AssemblyAngularVelocity = Vector3.new(4000, 4000, 4000)
	end)
end

